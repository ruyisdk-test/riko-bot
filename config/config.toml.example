# config/config.toml - configuration file

[app]
# Basic application configuration
name="riko"
version="0.1.0"
debug=false
environment="development" # environment: development or production

[path]
# Path configuration
cache_dir="./cache" # cache directory
base_dir=" "

[data_dirs]
# Data directories for each submodule
nvchecker="nvchecker" # nvchecker data directory
ruyi="ruyi" # ruyi data directory
riko="riko" # riko data directory

[repo]
# Repository configuration
use_ruyi_iscas_mirror=true # whether to use the ISCAS mirror
ruyi_mirror_url="https://mirrors.iscas.ac.cn/git/ruyisdk/packages-index.git" # ruyi mirror URL
packages_index_url="https://mirror.iscas.ac.cn/git/ruyisdk/packages-index.git" # packages-index repository URL

[nvchecker]
# nvchecker configuration
keyfile="nvchecker_keyfile.toml" # nvchecker key file
concurrency=20 # concurrency
max_fails=3 # maximum number of failures

[database]
# Database configuration
url="sqlite:///cache/riko/riko.db" # database URL
echo=false # whether to print SQL statements

[schedule]
# Scheduled task configuration
enable=true # whether to enable scheduled tasks
check_interval_hours=24 # check interval (hours)

[github]
# GitHub configuration
token=" " # GitHub access token
repo_owner="SmulllLu" # repository owner
repo_name="packages-index" # repository name
base_branch="pr" # PR target branch

[pr]
# PR configuration
branch_prefix="manifest-update" # feature branch prefix

[telegram]
# Telegram bot configuration (leave empty to disable notifications)
token=""
chat_id=""

[logging]
# Logging configuration
level="INFO" # log level
file="" # leave empty to output to console
max_bytes=10485760 # maximum log file size (bytes)
backup_count=5 # number of log file backups
